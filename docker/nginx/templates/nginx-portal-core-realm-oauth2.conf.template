# ---- oauth2-proxy CORE realm (${SSO_PORTAL_DEFAULT_REALM_SLUG}) ----
# Rendered by docker-entrypoint.sh via envsubst — do not hardcode a customer slug.
location ~ ^/oauth2/${SSO_PORTAL_DEFAULT_REALM_SLUG}/(.*)$ {
    proxy_pass http://$oauth2_core_upstream/oauth2/$1$is_args$args;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_buffer_size 128k;
    proxy_buffers 8 128k;
    proxy_busy_buffers_size 256k;
    proxy_read_timeout 120s;
}
