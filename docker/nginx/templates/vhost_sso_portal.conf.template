# ${PORTAL_DOMAIN} — Portail SSO (Phase 7 Docker, HTTP derrière frontal DMZ)
# Variables envsubst: PORTAL_DOMAIN, SSO_PORTAL_DEFAULT_REALM_SLUG

server {
    # default_server: conf.d/*.conf is alphabetical — subdomain/public_proxy
    # server{} blocks must NOT steal Host 127.0.0.1 (healthchecks /_portal_nginx_ok).
    listen 0.0.0.0:8080 default_server;
    server_name ${PORTAL_DOMAIN} _;
    server_tokens off;

    # Derrière edge TLS :443 (sync-acme-tls) — ne pas réécrire Location en :8080
    absolute_redirect off;
    port_in_redirect off;

    # Variables → resolver Docker (évite upstream figé si alias vpcbr recréés)
    set $bastion_app_upstream bastion-app:8000;
    set $oauth2_core_upstream oauth2-proxy-core:4180;
    # Subdomain auth maps/snippet are included on the portal default_server too.
    # Declare empties so nginx 1.30+ accepts map/log_format vars when no app
    # subdomain vhost has run set/auth_request_set yet.
    set $bastion_vhost_fqdn "";
    set $bastion_pass_cookie "";
    set $bastion_pass_session "";
    set $bastion_auth_cookie "";
    set $bastion_auth_err "";

    access_log /var/log/nginx/portal.access.log portal;
    error_log  /var/log/nginx/portal.error.log warn;

    client_max_body_size 32M;
    large_client_header_buffers 8 32k;
    send_timeout 60s;
    client_body_timeout 30s;
    client_header_timeout 30s;
    keepalive_timeout 65s;

    # Security headers (HSTS/…) are set once on the public TLS edge
    # (sync-acme-tls.sh :443 → includes/security-headers.conf). Do not re-add
    # them here on :8080 — duplicates appear as comma-joined values (audit F-09).
    # Keep only cache/rate headers in locations.

    include /etc/nginx/snippets/error_pages.conf;
    error_page 404 = /__portal_err/404;
    error_page 500 502 503 504 = /__portal_err/500;
    error_page 429 = @portal_rate_limited;
    # ModSecurity CRS — EMERGENCY Off (2026-08-06): request-time HTTP 500 on ModSec paths
    # (/auth/login, /, …) while locations with « modsecurity off » (health) stayed 200.
    # crs-setup-generated was ruled out (#113); engine-mode On + CRS still 500. Re-enable
    # only after error.log / modsec root cause is fixed (see docs/ops-modsecurity-crs.md).
    modsecurity off;
    modsecurity_rules_file /etc/nginx/modsecurity/main-portal.conf;

    # Unknown Host discovery (bastion-nginx): Hosts not in nginx-known-hosts.map
    # are rewritten to a stub that records PendingHost + returns a neutral 403
    # (no portal/bastion branding). Map from conf.d/00-known-hosts-map.conf.
    # Keep portal as the only default_server — do not add a second one.
    if ($bastion_unknown_host) {
        rewrite ^ /__bastion_unknown_host last;
    }

    location = /__bastion_unknown_host {
        internal;
        auth_request off;
        modsecurity off;
        proxy_intercept_errors off;
        limit_req zone=portal_api burst=20 nodelay;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
        proxy_set_header X-Discovered-Host $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_pass http://$bastion_app_upstream/internal/unknown-host;
    }

    # Public URL must not reach FastAPI without the internal rewrite + token.
    location = /internal/unknown-host {
        internal;
        modsecurity off;
        return 404;
    }

    location @portal_rate_limited {
        default_type text/html;
        add_header X-Rate-Limited-By "portal-nginx" always;
        return 429 '<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"><title>Trop de requêtes</title></head><body><h1>Trop de requêtes (429)</h1></body></html>';
    }

    location = /__portal_err/404 {
        internal;
        auth_request off;
        modsecurity off;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
        proxy_pass http://$bastion_app_upstream/errors/404;
    }

    location = /__portal_err/500 {
        internal;
        auth_request off;
        modsecurity off;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
        proxy_pass http://$bastion_app_upstream/errors/500;
    }

    include /etc/nginx/mime.types;
    types_hash_max_size 2048;

    location ~ /\. {
        deny all;
        return 404;
    }

    location = /_portal_nginx_ok {
        modsecurity off;
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        default_type text/plain;
        return 200 "portal nginx ok\n";
    }

    location = /health {
        auth_request off;
        modsecurity off;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream/health;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    location = /api/health {
        auth_request off;
        modsecurity off;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream/api/health;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    location ^~ /static/ {
        auth_request off;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location ^~ /media/app-logos/ {
        auth_request off;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location ^~ /media/branding/ {
        auth_request off;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location = /favicon.ico {
        auth_request off;
        log_not_found off;
        access_log off;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
        proxy_pass http://$bastion_app_upstream/static/img/generic-shield.svg;
    }

    location = /logout {
        auth_request off;
        limit_req zone=portal_login burst=10 nodelay;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        proxy_set_header X-Portal-Realm-Slug $cookie_portal_realm_slug;
        proxy_set_header X-Portal-Auth-Source $portal_x_auth_source;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    location ^~ /breakglass {
        auth_request off;
        allow 127.0.0.0/8;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        limit_req zone=portal_login burst=5 nodelay;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    # F-06: emergency recovery API — must work without SSO; same LAN allowlist as /breakglass.
    # Exact locations beat ^~ /api/admin so auth_request is not applied here.
    location = /api/admin/breakglass/login {
        auth_request off;
        allow 127.0.0.0/8;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        limit_req zone=portal_login burst=5 nodelay;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }
    location = /api/admin/breakglass/logout {
        auth_request off;
        allow 127.0.0.0/8;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        limit_req zone=portal_login burst=5 nodelay;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    location ^~ /auth/ {
        auth_request off;
        limit_req zone=portal_login burst=10 nodelay;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    # Alias of /auth/login — must stay public. Bare /login otherwise matches
    # location / (auth_request) and can bounce absolute subdomain rd= in a loop.
    location = /login {
        auth_request off;
        limit_req zone=portal_login burst=10 nodelay;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    # Always delegate to FastAPI (SSO preferred over bg_session — see /internal/oauth2-auth).
    # auth_request uses /portal_auth_check (internal) → proxy_pass FastAPI path.
    # Public GETs to /internal/* must 404 like subdomain-auth (not fall through to / → 302 login).
    location = /internal/oauth2-auth {
        internal;
        modsecurity off;
        return 404;
    }
    location = /internal/portal-rfc1918-bypass-auth {
        internal;
        modsecurity off;
        return 404;
    }

    location = /portal_auth_check {
        internal;
        auth_request off;
        modsecurity off;

        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream/internal/oauth2-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        include /etc/nginx/snippets/proxy_portal_forwarded.conf;
        proxy_set_header X-Forwarded-Uri $request_uri;
        proxy_set_header Cookie $http_cookie;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
        proxy_buffering off;
    }

    include /etc/nginx/snippets/nginx-portal-core-realm-oauth2.conf;
    include /etc/nginx/snippets/nginx-portal-oauth2-static.conf;
    include /var/lib/sso-portal/exports/nginx-portal-realms.conf;

    location @portal_oauth2_signin {
        # Default post-login home is /apps (end-user portal). /dashboard is admin-only
        # and must not be baked into OIDC state for ARSYSTEMS-Users.
        set $portal_login_rd /apps;
        if ($uri ~ ^/admin) {
            set $portal_login_rd $uri;
        }
        return 302 /auth/login?rd=$portal_login_rd;
    }

    # Browser-facing /api/apps/* (launch-ping, open-with-identity, …).
    # Same SSO auth_request as location /, but proxy_intercept_errors off so FastAPI
    # JSON 401/403 (e.g. wrong app password) is NOT rewritten to /auth/login HTML.
    # auth_request 401 still hits error_page → @portal_oauth2_signin.
    location ^~ /api/apps/ {
        limit_req zone=portal_api burst=60 nodelay;
        auth_request /portal_auth_check;
        error_page 401 = @portal_oauth2_signin;
        proxy_intercept_errors off;

        auth_request_set $auth_user      $upstream_http_x_auth_request_user;
        auth_request_set $auth_email     $upstream_http_x_auth_request_email;
        auth_request_set $auth_groups    $upstream_http_x_auth_request_groups;
        auth_request_set $auth_preferred $upstream_http_x_auth_request_preferred_username;

        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;

        proxy_set_header X-User $auth_preferred;
        proxy_set_header X-User-Id $auth_user;
        proxy_set_header X-Email $auth_email;
        proxy_set_header X-Groups $auth_groups;
        proxy_set_header X-Preferred-Username $auth_preferred;
        proxy_set_header X-Portal-Realm-Slug $cookie_portal_realm_slug;
        proxy_set_header X-Portal-Auth-Source $portal_x_auth_source;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    location ^~ /api/admin {
        limit_req zone=portal_api burst=60 nodelay;
        auth_request /portal_auth_check;
        error_page 401 = @portal_oauth2_signin;

        auth_request_set $auth_user      $upstream_http_x_auth_request_user;
        auth_request_set $auth_email     $upstream_http_x_auth_request_email;
        auth_request_set $auth_groups    $upstream_http_x_auth_request_groups;
        auth_request_set $auth_preferred $upstream_http_x_auth_request_preferred_username;

        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;

        proxy_set_header X-User $auth_preferred;
        proxy_set_header X-User-Id $auth_user;
        proxy_set_header X-Email $auth_email;
        proxy_set_header X-Groups $auth_groups;
        proxy_set_header X-Preferred-Username $auth_preferred;
        proxy_set_header X-Portal-Realm-Slug $cookie_portal_realm_slug;
        proxy_set_header X-Portal-Auth-Source $portal_x_auth_source;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    location ^~ /admin {
        limit_req zone=portal_api burst=60 nodelay;
        auth_request /portal_auth_check;
        error_page 401 = @portal_oauth2_signin;

        auth_request_set $auth_user      $upstream_http_x_auth_request_user;
        auth_request_set $auth_email     $upstream_http_x_auth_request_email;
        auth_request_set $auth_groups    $upstream_http_x_auth_request_groups;
        auth_request_set $auth_preferred $upstream_http_x_auth_request_preferred_username;

        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;

        proxy_set_header X-User $auth_preferred;
        proxy_set_header X-User-Id $auth_user;
        proxy_set_header X-Email $auth_email;
        proxy_set_header X-Groups $auth_groups;
        proxy_set_header X-Preferred-Username $auth_preferred;
        proxy_set_header X-Portal-Realm-Slug $cookie_portal_realm_slug;
        proxy_set_header X-Portal-Auth-Source $portal_x_auth_source;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    # Session-cookie hop: public (HMAC in bastion_session_hop). reverse01 proxies
    # https://{app}/.bastion/session-cookies → here with Host=portal. Must beat
    # ^~ /api/internal/ auth_request — otherwise @portal_oauth2_signin returns
    # relative /auth/login?rd=/apps and the browser (still on the app FQDN) follows
    # into CrushFTP/grommunio login loops.
    location = /api/internal/session-cookie-hop {
        auth_request off;
        modsecurity off;
        limit_req zone=portal_api burst=30 nodelay;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }
    location = /api/internal/crush-cookie-hop {
        auth_request off;
        modsecurity off;
        limit_req zone=portal_api burst=30 nodelay;
        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    location ^~ /api/internal/ {
        auth_request /portal_auth_check;
        error_page 401 = @portal_oauth2_signin;

        auth_request_set $auth_user      $upstream_http_x_auth_request_user;
        auth_request_set $auth_email     $upstream_http_x_auth_request_email;
        auth_request_set $auth_groups    $upstream_http_x_auth_request_groups;
        auth_request_set $auth_preferred $upstream_http_x_auth_request_preferred_username;

        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;

        proxy_set_header X-User $auth_preferred;
        proxy_set_header X-User-Id $auth_user;
        proxy_set_header X-Email $auth_email;
        proxy_set_header X-Groups $auth_groups;
        proxy_set_header X-Preferred-Username $auth_preferred;
        proxy_set_header X-Portal-Realm-Slug $cookie_portal_realm_slug;
        proxy_set_header X-Portal-Auth-Source $portal_x_auth_source;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }

    # Smoke: subdomain-auth via nginx (internal location also available on default server)
    include /etc/nginx/snippets/subdomain_auth_common.conf;

    location / {
        limit_req zone=portal_api burst=60 nodelay;
        auth_request /portal_auth_check;
        error_page 401 = @portal_oauth2_signin;

        auth_request_set $auth_user      $upstream_http_x_auth_request_user;
        auth_request_set $auth_email     $upstream_http_x_auth_request_email;
        auth_request_set $auth_groups    $upstream_http_x_auth_request_groups;
        auth_request_set $auth_preferred $upstream_http_x_auth_request_preferred_username;

        include /etc/nginx/snippets/proxy_portal_strip_identity.conf;
        proxy_pass http://$bastion_app_upstream;
        include /etc/nginx/snippets/proxy_portal_fastapi.conf;

        proxy_set_header X-User $auth_preferred;
        proxy_set_header X-User-Id $auth_user;
        proxy_set_header X-Email $auth_email;
        proxy_set_header X-Groups $auth_groups;
        proxy_set_header X-Preferred-Username $auth_preferred;
        proxy_set_header X-Portal-Realm-Slug $cookie_portal_realm_slug;
        proxy_set_header X-Portal-Auth-Source $portal_x_auth_source;
        include /etc/nginx/snippets/proxy_portal_trusted_internal.conf;
    }
}
