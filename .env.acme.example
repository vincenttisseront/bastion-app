# Cloudflare DNS-01 for acme-companion (bastion public_proxy certs).
# Copy to .env.acme at the compose root (gitignored) and fill in.
#
# Token: Zone.DNS Edit on ar-systems.fr (or Account API token with Zone.DNS).
# https://github.com/acmesh-official/acme.sh/wiki/dnsapi#dns_cf

# CF_Token=...
# CF_Account_ID=...
# CF_Zone_ID=...   # optional but faster

# Optional overrides (also settable in compose environment):
# ACME_DNS_API=dns_cf
# ACME_CA=letsencrypt
# ACME_CA=letsencrypt_test
# ACME_ACCOUNT_EMAIL=ops@example.fr   # register-account (LE); sinon acme@PORTAL_DOMAIN
