# Infra reverse proxies on bastion-nginx (Keycloak, Grafana, Wiki, …).
# Generated by bastion_app_docker from bastion_infra_proxy_vhosts.
# HTTP :8080 (Host routing). Public TLS :443 via ACME sync (same Host → here).
# No bastion authentication (SSO / RBAC / FastAPI) — transparent proxy to vpcbr.

{% for vhost in bastion_infra_proxy_vhosts %}
{% if vhost.enabled | default(true) %}
# [{{ vhost.slug }}] {{ vhost.fqdn }} → {{ vhost.upstream_url }}
server {
    listen 0.0.0.0:8080;
    server_name {{ vhost.fqdn }};

    absolute_redirect off;
    port_in_redirect off;

    set $infra_upstream {{ vhost.upstream_url }};

    # Branded pages for errors raised by nginx itself (upstream down, body /
    # header too large). Upstream answers pass through untouched. Inline (no
    # snippet include) so an older bastion-nginx image still passes nginx -t.
    proxy_intercept_errors off;
    error_page 400 401 403 404 405 408 413 414 429 500 502 503 504 /__bastion_errors/$status.html;
    error_page 494 /__bastion_errors/494.html;
    error_page 495 /__bastion_errors/495.html;
    error_page 496 /__bastion_errors/496.html;
    location ^~ /__bastion_errors/ {
        internal;
        alias /var/www/nginx-errors/;
        modsecurity off;
        recursive_error_pages off;
        charset utf-8;
        charset_types text/html text/plain application/json;
        add_header Cache-Control "no-store" always;
    }

    location = /healthz {
        proxy_pass $infra_upstream/;
        proxy_redirect off;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass $infra_upstream;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Must be https when traffic came via :443 terminator (otherwise Keycloak
        # advertises issuer http://host:443 and OIDC discovery fails).
        proxy_set_header X-Forwarded-Proto $bastion_forwarded_proto;
        proxy_set_header X-Forwarded-Port  $bastion_forwarded_port;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $http_connection;
{% if vhost.proxy_buffering is defined %}
        proxy_buffering {{ vhost.proxy_buffering }};
{% endif %}
    }
}

{% endif %}
{% endfor %}
