# Infra reverse proxies on bastion-nginx (Keycloak, Grafana, Wiki, …).
# Generated by bastion_app_docker from bastion_infra_proxy_vhosts.
# HTTP :8080 (Host routing). Public TLS :443 via ACME sync (same Host → here).
# No bastion authentication (SSO / RBAC / FastAPI) — transparent proxy to vpcbr.

{% for vhost in bastion_infra_proxy_vhosts %}
{% if vhost.enabled | default(true) %}
# [{{ vhost.slug }}] {{ vhost.fqdn }} → {{ vhost.upstream_url }}
server {
    listen 0.0.0.0:8080;
    server_name {{ vhost.fqdn }};

    absolute_redirect off;
    port_in_redirect off;

    set $infra_upstream {{ vhost.upstream_url }};

    location = /healthz {
        proxy_pass $infra_upstream/;
        proxy_redirect off;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass $infra_upstream;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Must be https when traffic came via :443 terminator (otherwise Keycloak
        # advertises issuer http://host:443 and OIDC discovery fails).
        proxy_set_header X-Forwarded-Proto $bastion_forwarded_proto;
        proxy_set_header X-Forwarded-Port  $bastion_forwarded_port;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $http_connection;
{% if vhost.proxy_buffering is defined %}
        proxy_buffering {{ vhost.proxy_buffering }};
{% endif %}
    }
}

{% endif %}
{% endfor %}
