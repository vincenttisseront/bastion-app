# {{ ansible_managed }} — bastion-app Docker .env
PORTAL_DOMAIN={{ portal_domain }}
SSO_PORTAL_DEFAULT_REALM_SLUG={{ sso_portal_default_realm_slug }}
VAULT_PORTAL_INTERNAL_TOKEN={{ vault_portal_internal_token }}
{% if breakglass_jwt_secret | default('') | length > 0 %}
BREAKGLASS_JWT_SECRET={{ breakglass_jwt_secret }}
{% endif %}
BREAKGLASS_JWT_SECRET_FALLBACK_ENABLED={{ 'true' if (breakglass_jwt_secret_fallback_enabled | default(true)) else 'false' }}
VAULT_SSO_PORTAL_OIDC_CLIENT_SECRET={{ vault_sso_portal_oidc_client_secret }}
VAULT_PORTAL_VAULT_FERNET_KEY={{ vault_portal_vault_fernet_key }}
PORTAL_SECRET_ENCRYPTION_KEY={{ portal_secret_encryption_key | default(vault_portal_vault_fernet_key) }}
VAULT_PORTAL_DB_ENCRYPTION_KEY={{ vault_portal_db_encryption_key }}
DATABASE_URL=sqlite:////var/lib/sso-portal/portal.db
EXPORTS_DIR=/var/lib/sso-portal/exports
PORTAL_DATA_DIR=/var/lib/sso-portal
VAULT_KEYS_DIR=/var/lib/sso-portal/keys
OAUTH2_PROXY_NETWORK_MODE=docker
OAUTH2_PROXY_DEFAULT_URL=http://oauth2-proxy-core:4180
# false: Traefik/vpcbr IPs are 10.5.0.0/16 — bypass would skip SSO identity (auth loop).
RFC1918_BYPASS_ENABLED=false
SSO_PORTAL_DATA_DIR={{ bastion_app_docker_data_dir }}
OAUTH2_PROXY_IMAGE_TAG={{ oauth2_proxy_image_tag }}
PORTAL_DOMAIN={{ portal_domain }}
LOG_LEVEL=INFO
LOG_FORMAT=text
