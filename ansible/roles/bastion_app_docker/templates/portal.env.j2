# {{ ansible_managed }} — bastion-app Docker .env
PORTAL_DOMAIN={{ portal_domain }}
PORTAL_ENVIRONMENT={{ portal_environment | default('production') }}
SSO_PORTAL_DEFAULT_REALM_SLUG={{ sso_portal_default_realm_slug }}
VAULT_PORTAL_INTERNAL_TOKEN={{ vault_portal_internal_token }}
{% if breakglass_jwt_secret | default('') | length > 0 %}
BREAKGLASS_JWT_SECRET={{ breakglass_jwt_secret }}
{% endif %}
{% if session_hop_secret | default('') | length > 0 %}
SESSION_HOP_SECRET={{ session_hop_secret }}
{% endif %}
BREAKGLASS_JWT_SECRET_FALLBACK_ENABLED={{ 'true' if (breakglass_jwt_secret_fallback_enabled | default(true)) else 'false' }}
VAULT_SSO_PORTAL_OIDC_CLIENT_SECRET={{ vault_sso_portal_oidc_client_secret }}
VAULT_PORTAL_VAULT_FERNET_KEY={{ vault_portal_vault_fernet_key }}
PORTAL_SECRET_ENCRYPTION_KEY={{ portal_secret_encryption_key | default(vault_portal_vault_fernet_key) }}
VAULT_PORTAL_DB_ENCRYPTION_KEY={{ vault_portal_db_encryption_key }}
DATABASE_URL=sqlite:////var/lib/sso-portal/portal.db
EXPORTS_DIR=/var/lib/sso-portal/exports
PORTAL_DATA_DIR=/var/lib/sso-portal
FILES_STORAGE_DIR=/var/lib/sso-portal-files/private/files
VAULT_KEYS_DIR=/var/lib/sso-portal/keys
OAUTH2_PROXY_NETWORK_MODE=docker
OAUTH2_PROXY_DEFAULT_URL=http://oauth2-proxy-core:4180
# false: Traefik/vpcbr IPs are 10.5.0.0/16 — bypass would skip SSO identity (auth loop).
RFC1918_BYPASS_ENABLED=false
# Honour X-Real-IP only from nginx-bastion (docker) / loopback — not from the Internet.
TRUSTED_PROXY_CIDRS=10.5.0.0/16,172.17.0.0/16,127.0.0.0/8
# HMAC hop / break-glass JWT: seeded into portal_settings by migrate when unset here.
SSO_PORTAL_DATA_DIR={{ bastion_app_docker_data_dir }}
SSO_PORTAL_FILES_DATA_DIR={{ bastion_app_docker_files_data_dir }}
OAUTH2_PROXY_IMAGE_TAG={{ oauth2_proxy_image_tag }}
PORTAL_DOMAIN={{ portal_domain }}
LOG_LEVEL=INFO
LOG_FORMAT=text
# Container logs UI is configured in Admin → Sécurité → Logs containers (DB).
# Legacy DOCKER_LOGS_* env vars are only read once at migration seed time, then ignored.
# Overlay still needed for the proxy: docker-compose.docker-logs.yml
ADMIN_LOGS_SSE_TIMEOUT_SECONDS={{ admin_logs_sse_timeout_seconds | default(1800) }}
{# Optional hot-store Postgres — password from AWX Vault / Extra Vars.
   Accepted names: vault_hot_store_pg_password | hot_store_pg_password | HOT_STORE_PG_PASSWORD #}
{% set _hs_pw = (
      vault_hot_store_pg_password
      | default(hot_store_pg_password | default(HOT_STORE_PG_PASSWORD | default('')), true)
    ) | trim
%}
{% if _hs_pw | length > 0 %}
HOT_STORE_PG_USER={{ hot_store_pg_user | default('bastion_hot') }}
HOT_STORE_PG_PASSWORD={{ _hs_pw }}
HOT_STORE_PG_DB={{ hot_store_pg_db | default('bastion_hot') }}
{% endif %}
