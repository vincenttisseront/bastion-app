# {{ ansible_managed }}
[Unit]
Description=Bastion SSO Portal (FastAPI)
After=network.target

[Service]
Type=simple
User={{ sso_portal_user }}
Group={{ sso_portal_user }}
WorkingDirectory={{ sso_portal_install_dir }}
EnvironmentFile={{ sso_portal_env_path }}
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH={{ sso_portal_install_dir }}
ExecStart={{ sso_portal_venv }}/bin/python -m uvicorn app.main:app --host {{ sso_portal_bind_host }} --port {{ sso_portal_bind_port }} --app-dir {{ sso_portal_install_dir }}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ sso_portal_data_dir }} {{ sso_portal_venv }} {{ sso_portal_release_dir }} {{ sso_portal_install_dir }}

[Install]
WantedBy=multi-user.target
