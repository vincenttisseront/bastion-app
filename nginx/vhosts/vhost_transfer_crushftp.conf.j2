# {{ ansible_managed }}
# {{ transfer_domain }} — CrushFTP proxy infra (login natif, sans auth_request bastion)
# Aligné sur l'ancien bloc DMZ embarqué (proxy_cookie_path, pas de WAF sur ce vhost).
#
# CONTRACT (validated 2026-07-27 — Transfer robotic auto-login):
# 1. Hop paths under /.bastion/ (session-cookies + crush-session alias):
#    auth_request off, never "internal"; Host=portal; X-Real-IP $remote_addr.
# 2. CrushFTP upstream (/, new-ui, webfs, login.html): X-Real-IP/XFF = $server_addr
#    so robotic SSO (via FQDN) and browser share reverse IP — NEVER $remote_addr here.
# 3. login.html: expire Domain=parent CrushAuth/currentAuth (host-only clears alone → loop).
# Deployed by linux_sso_portal_docker.yml → session_cookie_hop_edge.yml (and linux_nginx_dmz).

server {
    listen 80;
    server_name {{ transfer_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ transfer_domain }};

    ssl_certificate {{ ssl_certificate_path }};
    ssl_certificate_key {{ ssl_certificate_key }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    access_log /var/log/nginx/transfer.access.log main;
    error_log  /var/log/nginx/transfer.error.log warn;

    client_max_body_size 2G;
    large_client_header_buffers 8 32k;
    rewrite ^//+ / permanent;

    # Ne pas réécrire Path avec SameSite/Secure : CrushFTP les envoie déjà →
    # doublon "SameSite=None; Secure; secure; SameSite=None" → Firefox rejette les cookies → boucle login.
    # proxy_cookie_path / "/; SameSite=None; Secure";

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    include /etc/nginx/snippets/error_pages.conf;
    # Pas de waf-basic ici — évite faux positifs sur /WebInterface/function/ (POST login, getUsername).

    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_hide_header WWW-Authenticate;

    # Post-login CrushFTP redirige souvent vers / → 401 + cookies anonymes qui écrasent la session
    location = / {
        return 302 /WebInterface/new-ui/index.html;
    }

    # Cookie hop: portal seals target session cookies into bastion_session_hop
    # (Domain=parent), then lands here so Set-Cookie without Domain is host-only.
    # Upstream Host=portal for Traefik; browser still sees transfer.* → host-only cookies.
    #
    # CRITICAL: do NOT add `internal;` — browser navigates via a real 302.
    # Exact `=` must beat `location ~ /\. { deny all; }` below (otherwise 403).
    location = /.bastion/session-cookies {
        auth_request off;
        proxy_pass {{ bastion_app_proxy_pass | default('https://172.24.0.110') }}/api/internal/session-cookie-hop;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host {{ portal_domain | default('portal.ar-systems.fr') }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_pass_request_body off;
    }
    # Legacy CrushFTP-era path (same handler)
    location = /.bastion/crush-session {
        auth_request off;
        proxy_pass {{ bastion_app_proxy_pass | default('https://172.24.0.110') }}/api/internal/session-cookie-hop;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host {{ portal_domain | default('portal.ar-systems.fr') }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_pass_request_body off;
    }

    # Expire Domain=parent CrushAuth that CrushFTP clears host-only only (else login.html loop).
    location = /WebInterface/login.html {
        proxy_pass {{ transfer_backend }};
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_ssl_session_reuse off;
        proxy_ssl_protocols TLSv1.2;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Real-IP $server_addr;
        proxy_set_header X-Forwarded-For $server_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        add_header Set-Cookie "CrushAuth=; Path=/; Domain={{ transfer_cookie_parent_domain | default('ar-systems.fr') }}; Max-Age=0; Secure; HttpOnly" always;
        add_header Set-Cookie "currentAuth=; Path=/; Domain={{ transfer_cookie_parent_domain | default('ar-systems.fr') }}; Max-Age=0; Secure" always;
    }

    # WebSocket new-ui / webfs
    location /webfs/ {
        proxy_pass {{ transfer_backend }};
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Host public (pas l'IP backend) — sinon session OK en direct IP, boucle login via transfer.*
        proxy_set_header Host $host;
        # Cookie navigateur complet — le filtre $transfer_crushftp_backend_cookie (1 seul
        # currentAuth* si _kc_* présent) casse la session new-ui → boucle login.
        proxy_set_header Cookie $http_cookie;
        # CrushFTP invalide la session si l'IP change (robotic login depuis docker
        # vs navigateur). Forcer une IP stable = reverse, pas le client réel.
        proxy_set_header X-Real-IP $server_addr;
        proxy_set_header X-Forwarded-For $server_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    # CrushFTP coupe le TLS sur GET /WebInterface/new-ui/ (Content-Length 4096, corps vide).
    # index.html est servi correctement (~20 Ko) — forcer le fichier explicite.
    location = /WebInterface/new-ui {
        return 302 /WebInterface/new-ui/index.html;
    }
    location = /WebInterface/new-ui/ {
        return 302 /WebInterface/new-ui/index.html;
    }

    location /WebInterface/new-ui/upload/ {
        proxy_pass {{ transfer_backend }};
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_ssl_session_reuse off;
        proxy_ssl_protocols TLSv1.2;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        # Cookie navigateur complet — le filtre $transfer_crushftp_backend_cookie (1 seul
        # currentAuth* si _kc_* présent) casse la session new-ui → boucle login.
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Real-IP $server_addr;
        proxy_set_header X-Forwarded-For $server_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        add_header X-Frame-Options "SAMEORIGIN" always;
    }

    location / {
        proxy_pass {{ transfer_backend }};
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_ssl_session_reuse off;
        proxy_ssl_protocols TLSv1.2;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        # Cookie navigateur complet — le filtre $transfer_crushftp_backend_cookie (1 seul
        # currentAuth* si _kc_* présent) casse la session new-ui → boucle login.
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Real-IP $server_addr;
        proxy_set_header X-Forwarded-For $server_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;

        proxy_connect_timeout 120s;
        proxy_read_timeout 299s;
        proxy_send_timeout 300s;

        # Pas de proxy_redirect login.html → new-ui : après login, CrushFTP peut renvoyer
        # volontairement login.html si la session/cookie est invalide ; forcer new-ui = boucle.
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
