# {{ ansible_managed }}
# Vhost subdomain SSO — {{ vhost.fqdn }}
# TRANSITIONAL DMZ template. Preferred path: App DB → exports/nginx-subdomain-apps.conf
# loaded by bastion-nginx (front). Same hop contract (/.bastion/session-cookies).

server {
    listen 80;
    server_name {{ vhost.fqdn }};
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ vhost.fqdn }};

    ssl_certificate     {{ vhost.ssl_cert | default(nginx_ssl_cert_default) }};
    ssl_certificate_key {{ vhost.ssl_key  | default(nginx_ssl_key_default) }};

    access_log /var/log/nginx/{{ vhost.slug }}_subdomain_access.log;
    error_log  /var/log/nginx/{{ vhost.slug }}_subdomain_error.log;

    set $fastapi_upstream http://{{ sso_portal_bind_host | default('127.0.0.1') }}:{{ sso_portal_bind_port | default('8000') }};
    set $app_upstream     {{ vhost.upstream_url }};
    # Literal FQDN for auth_request (must survive rewrite re-run on subrequest).
    set $bastion_vhost_fqdn "{{ vhost.fqdn }}";
    # Client Cookie for auth_request (before CrushFTP upstream Cookie filter).
    set $bastion_pass_cookie $http_cookie;
    set $bastion_pass_session $cookie_bastion_session;

    # ─── Bloc interne auth subdomain ──────────────────────────────────────────
    # Définit location = /internal/subdomain-auth avec auth_request off
    include snippets/subdomain_auth_common.conf;

    # ─── Redirections legacy /proxy/{slug}/ depuis ce vhost ─────────────────
{% include 'snippets/proxy_subdomain_redirects.conf.j2' %}

    # ─── Sonde santé applicative (pas d'auth) ─────────────────────────────────
    # CrushFTP répond 302 sur GET / — sonde via GET (pas HEAD)
    location = /healthz {
        auth_request off;
        proxy_pass $app_upstream/;
        proxy_redirect off;
        proxy_set_header Host $host;
    }

    # ─── Cookie hop (host-only target session cookies on this FQDN) ───────────
    # CRITICAL: do NOT add `internal;` — browser navigates here via a real 302
    # after portal seals bastion_session_hop. Security is the signed hop token
    # validated by FastAPI, not Nginx internal;.
    location = /.bastion/session-cookies {
        auth_request off;
        proxy_pass {{ bastion_app_proxy_pass | default('https://172.24.0.110') }}/api/internal/session-cookie-hop;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host {{ portal_domain | default('portal.ar-systems.fr') }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_pass_request_body off;
    }

    # ─── Route principale — protégée par auth_request ─────────────────────────
    # REGLE : auth_request + error_page 401 uniquement ici (jamais au niveau server)
    # Capture Cookie in parent before auth_request ($http_cookie empty on subrequest).
    location / {
        set $bastion_pass_cookie $http_cookie;
        set $bastion_pass_session $cookie_bastion_session;
        auth_request /internal/subdomain-auth;
        auth_request_set $bastion_auth_err $upstream_http_x_auth_error;

        # error_page 401 dans location, jamais au niveau server (dfcc5c7)
        error_page 401 = @portal_redirect_{{ vhost.slug }};
        # Do not map upstream/CrushFTP 401 through @portal_redirect.
        proxy_intercept_errors off;

        proxy_pass $app_upstream;
        proxy_redirect off;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $bastion_forwarded_proto;

        # Propagation cookies applicatifs (CrushFTP : CrushAuth, currentAuth)
        proxy_cookie_path / /;
        proxy_cookie_domain {{ vhost.upstream_host | default('172.24.0.106') }} {{ vhost.fqdn }};

        # Identité transmise par FastAPI subdomain_auth
        auth_request_set $auth_user $upstream_http_x_auth_user;
        auth_request_set $auth_app  $upstream_http_x_auth_app;
        proxy_set_header X-Auth-User $auth_user;
        proxy_set_header X-Auth-App  $auth_app;
    }

    # ─── Redirection vers portail pour login ──────────────────────────────────
    # /auth/login is auth_request off (unlike bare /login → location / bounce loop).
    location @portal_redirect_{{ vhost.slug }} {
        # bastion_sub=1 stops /auth/login from bouncing back (auth_request 401 loop).
        return 302 https://{{ portal_domain }}/auth/login?rd=$scheme://$host$request_uri&bastion_sub=1&ae=$bastion_auth_err;
    }
}
