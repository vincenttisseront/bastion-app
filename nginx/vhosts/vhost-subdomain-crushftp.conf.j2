# {{ ansible_managed }}
# CrushFTP subdomain ÔÇö {{ app.server_name }}
# Backend ├á / ÔÇö aucun rewrite /proxy/ ni crush-admin-proxy.
{% set _subdomain_auth = app.subdomain_auth_enabled | default(sso_portal_subdomain_auth_enabled | default(false)) | bool %}
{% if not _subdomain_auth %}
# Mode test : proxy direct vers CrushFTP (pas d'auth_request / redirect Keycloak).
{% endif %}

server {
    listen 80;
    server_name {{ app.server_name }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ app.server_name }};

    ssl_certificate {{ app.ssl_certificate | default(ssl_certificate_path | default('/etc/letsencrypt/live/ar-systems.fr/fullchain.pem')) }};
    ssl_certificate_key {{ app.ssl_certificate_key | default(ssl_certificate_key | default('/etc/letsencrypt/live/ar-systems.fr/privkey.pem')) }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    access_log /var/log/nginx/{{ app.log_name | default(app.server_name) }}.access.log main;
    error_log  /var/log/nginx/{{ app.log_name | default(app.server_name) }}.error.log warn;

    client_max_body_size 0;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    include /etc/nginx/snippets/error_pages.conf;
    include /etc/nginx/includes/waf-basic.conf;

{% if _subdomain_auth %}
{% include 'snippets/subdomain_auth_check.conf.j2' %}
{% endif %}

    # CrushFTP WebSocket (new-ui / webfs)
    location /webfs/ {
{% if _subdomain_auth %}
{% include 'snippets/subdomain_auth_protect.conf.j2' %}
{% endif %}
        proxy_pass {{ app.internal_upstream }};
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host {{ app.backend_host }};
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if _subdomain_auth %}
        proxy_set_header X-Remote-User $subdomain_remote_user;
{% endif %}
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location / {
{% if _subdomain_auth %}
{% include 'snippets/subdomain_auth_protect.conf.j2' %}
{% endif %}
        proxy_pass {{ app.internal_upstream }};
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_ssl_protocols TLSv1.2;
        proxy_ssl_session_reuse off;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_set_header Host {{ app.backend_host }};
        proxy_set_header Connection "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if _subdomain_auth %}
        proxy_set_header X-Remote-User $subdomain_remote_user;
{% endif %}
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
