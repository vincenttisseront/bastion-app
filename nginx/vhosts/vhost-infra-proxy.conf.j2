{# Mirror / docs — same contract as bastion_app_docker nginx-infra-proxy-apps.conf.j2.
   Preferred runtime path: Ansible writes exports/nginx-infra-proxy-apps.conf
   consumed by bastion-nginx entrypoint.
#}
{% for vhost in bastion_infra_proxy_vhosts | default([]) %}
{% if vhost.enabled | default(true) %}
server {
    listen 80;
    server_name {{ vhost.fqdn }};
    set $infra_upstream {{ vhost.upstream_url }};
    location / {
        proxy_pass $infra_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $bastion_forwarded_proto;
        proxy_set_header X-Forwarded-Port  $bastion_forwarded_port;
        proxy_set_header X-Forwarded-Host  $host;
{% endif %}
{% endfor %}
