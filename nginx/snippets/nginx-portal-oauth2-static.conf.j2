    # oauth2-proxy static assets (CSS pages d'erreur 403/401) — sans auth_request
    # Évite la boucle : /oauth2/static/ → catch-all → 401 → /start?rd=/oauth2/static/...
    location ^~ /oauth2/static/ {
        proxy_pass http://{{ oauth2_core_listen }}/oauth2/static/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_buffering off;
    }
