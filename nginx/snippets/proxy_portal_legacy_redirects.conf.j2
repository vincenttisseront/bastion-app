# {{ ansible_managed }}
# Snippet : redirections legacy /proxy/{slug}/ vers subdomain SSO
# Inclus dans le vhost portail. auth_request off implicite (return 301)

{% for app in nginx_legacy_proxy_redirects | default([]) %}
# Legacy redirect : /proxy/{{ app.slug }}/ vers {{ app.fqdn }}
location ^~ /proxy/{{ app.slug }}/ {
    return 301 https://{{ app.fqdn }}$request_uri;
}
{% endfor %}

{% if nginx_legacy_proxy_catch_all | default(true) %}
# Catch-all : tout /proxy/ non résolu vers portail (évite les 404 confusants)
location ^~ /proxy/ {
    return 302 https://{{ portal_domain }}/;
}
{% endif %}
