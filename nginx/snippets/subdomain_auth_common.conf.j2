# {{ ansible_managed }}
# Snippet : auth subdomain commun
# Inclus dans tous les vhosts subdomain SSO
# CRITIQUE : auth_request off sur ce bloc interne (évite récursion — fe15325)
#
# Host: $bastion_vhost_fqdn (literal set in server{}).
# Cookie: parent location / snapshots $bastion_pass_* from $cookie_bastion_session
# / $http_cookie then auth_request in the SAME location (never return 418 → gate —
# nested error_page breaks @portal_redirect → bare nginx 401 HTML).
# Never if{} / map pick←pass (404 / 500). Never re-set at server{} (ck=72 wipe).
# Use $bastion_pass_* / $bastion_auth_cookie DIRECTLY — no $http_cookie fallback.
# proxy_pass_request_headers off: prevents CrushFTP upstream Cookie filter
# inheritance into auth.

location = /internal/subdomain-auth {
    internal;
    auth_request off;   # CRITIQUE : évite la récursion auth_request

    proxy_pass http://{{ sso_portal_bind_host | default('127.0.0.1') }}:{{ sso_portal_bind_port | default('8000') }}/internal/subdomain-auth;
    proxy_pass_request_body off;
    proxy_pass_request_headers off;
    # auth_request defaults to HTTP/1.0; force 1.1 so identity response headers
    # reach auth_request_set (X-Forwarded-Email for trusted-header upstreams).
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Content-Length  "";
    proxy_set_header Host            $bastion_vhost_fqdn;
    proxy_set_header X-Original-URI  $request_uri;
    proxy_set_header X-Original-Host $bastion_vhost_fqdn;
    # Same resolved client as portal (CF real_ip + X-Portal-Client-IP fallback).
    proxy_set_header X-Real-IP       $portal_client_real_ip;
    proxy_set_header X-Forwarded-For $portal_client_real_ip;
    proxy_set_header X-Portal-Client-IP $portal_client_real_ip;
    proxy_set_header X-Forwarded-Proto $bastion_forwarded_proto;
    proxy_set_header Cookie          $bastion_auth_cookie;
    proxy_set_header X-Bastion-Session-Cookie $bastion_pass_session;

    # Ne pas intercepter les erreurs du backend FastAPI
    proxy_intercept_errors off;
}

location = /internal/activesync-auth {
    internal;
    auth_request off;

    proxy_pass http://{{ sso_portal_bind_host | default('127.0.0.1') }}:{{ sso_portal_bind_port | default('8000') }}/internal/activesync-auth;
    proxy_pass_request_body off;
    proxy_pass_request_headers off;
    proxy_set_header Content-Length  "";
    proxy_set_header Host            $bastion_vhost_fqdn;
    proxy_set_header X-Original-URI  $request_uri;
    # auth_request is always a GET: without this the handler cannot tell an
    # OPTIONS protocol negotiation (no DeviceId) from a real sync command.
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-Host $bastion_vhost_fqdn;
    # Same resolved client as portal (CF real_ip + X-Portal-Client-IP fallback).
    proxy_set_header X-Real-IP       $portal_client_real_ip;
    proxy_set_header X-Forwarded-For $portal_client_real_ip;
    proxy_set_header X-Portal-Client-IP $portal_client_real_ip;
    proxy_set_header X-Forwarded-Proto $bastion_forwarded_proto;
    proxy_set_header Cookie          $bastion_auth_cookie;
    proxy_set_header X-Bastion-Session-Cookie $bastion_pass_session;
    proxy_set_header Authorization   $http_authorization;
    proxy_set_header User-Agent      $http_user_agent;
    proxy_intercept_errors off;
}
