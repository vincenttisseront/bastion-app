PORTAL_DOMAIN=portal.example.com
SSO_PORTAL_DEFAULT_REALM_SLUG=default
PORTAL_ENVIRONMENT=production
VAULT_PORTAL_INTERNAL_TOKEN=CHANGE_ME_long_random
# HMAC break-glass JWT — required when PORTAL_ENVIRONMENT=production
BREAKGLASS_JWT_SECRET=
# HMAC session-cookie hop — required outside PORTAL_ENVIRONMENT=test
SESSION_HOP_SECRET=
VAULT_SSO_PORTAL_OIDC_CLIENT_SECRET=
VAULT_PORTAL_VAULT_FERNET_KEY=
PORTAL_SECRET_ENCRYPTION_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SQLCipher file encryption key (64 hex). Generate: openssl rand -hex 32
# VAULT_PORTAL_DB_ENCRYPTION_KEY=

# Docker stack paths (inside containers)
DATABASE_URL=sqlite:////var/lib/sso-portal/portal.db
EXPORTS_DIR=/var/lib/sso-portal/exports
PORTAL_DATA_DIR=/var/lib/sso-portal
OAUTH2_PROXY_NETWORK_MODE=docker
OAUTH2_PROXY_DEFAULT_URL=http://oauth2-proxy-core:4180

# Host binds (compose)
SSO_PORTAL_DATA_DIR=./data/sso-portal
SSO_PORTAL_FILES_DATA_DIR=./data/sso-portal-files

# Optional Postgres hot store (Admin → Configuration → Stockage chaud)
# HOT_STORE_PG_USER=bastion_hot
# HOT_STORE_PG_PASSWORD=change-me
# HOT_STORE_PG_DB=bastion_hot

# Feature flags — leave false behind a public edge
RFC1918_BYPASS_ENABLED=false
SUBDOMAIN_SSO_ENABLED=false
SUBDOMAIN_AUTH_ENABLED=false

# Docker Hub images (repos dédiés — défauts alignés sur deploy/docker-compose.yml)
# BASTION_APP_IMAGE=vincenttisseront/bastion-pro-app:latest
# BASTION_MIGRATE_IMAGE=vincenttisseront/bastion-pro-migrate:latest
# BASTION_NGINX_IMAGE=vincenttisseront/bastion-pro-nginx:latest
# Pin SHA : …:6b2be94

LOG_LEVEL=INFO
LOG_FORMAT=text
