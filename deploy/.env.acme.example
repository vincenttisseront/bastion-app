# DNS-01 credentials for acme-companion (portal + app FQDNs).
# Copy to .env.acme (gitignored) and fill in.
#
# Gate: your DNS zone must be on the chosen provider (ex. Cloudflare)
# with a token that can edit Zone DNS. See deploy/README.md.
# https://github.com/acmesh-official/acme.sh/wiki/dnsapi#dns_cf

# CF_Token=...
# CF_Account_ID=...
# CF_Zone_ID=...   # optional but faster

# Optional overrides:
# ACME_DNS_API=dns_cf
# ACME_CA=letsencrypt_test   # staging first
# ACME_CA=letsencrypt        # production
# ACME_ACCOUNT_EMAIL=ops@example.com
