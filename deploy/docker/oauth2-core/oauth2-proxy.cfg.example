# oauth2-proxy core — bootstrap stub (generic).
# After Admin → Realms + Apply infra, exports overwrite the live config
# mounted from data/sso-portal/exports (see deploy README).
# http_address must listen on 0.0.0.0 for Docker.

http_address = "0.0.0.0:4180"
upstreams = [ "file:///dev/null" ]
reverse_proxy = true
skip_provider_button = true
provider = "oidc"
oidc_issuer_url = "https://idp.example.com/realms/myrealm"
client_id = "sso-portal"
client_secret = "REPLACE_ME"
redirect_url = "https://portal.example.com/oauth2/default/callback"
cookie_secret = "REPLACE_WITH_32_BYTE_URLSAFE_BASE64"
# PKCE required by many IdPs (Keycloak, etc.)
code_challenge_method = "S256"
scope = "openid profile email"
email_domains = ["*"]
insecure_oidc_allow_unverified_email = true
cookie_secure = true
cookie_httponly = true
cookie_samesite = "lax"
cookie_expire = "12h"
cookie_refresh = "1h"
cookie_domains = [ ".example.com" ]
whitelist_domains = [ ".example.com" ]
set_xauthrequest = true
pass_access_token = false
pass_authorization_header = true
