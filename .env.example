PORTAL_DOMAIN=portal.example.com
SSO_PORTAL_DEFAULT_REALM_SLUG=default
PORTAL_ENVIRONMENT=production
VAULT_PORTAL_INTERNAL_TOKEN=CHANGE_ME_long_random
# Optional: HMAC base for CSRF / flash / MFA cookies. MUST differ from the internal token.
# Leave empty to let the portal generate and store one (portal_settings, Fernet).
# PORTAL_SIGNING_SECRET=
# HMAC break-glass JWT — required when PORTAL_ENVIRONMENT=production
BREAKGLASS_JWT_SECRET=
# HMAC session-cookie hop — required outside PORTAL_ENVIRONMENT=test
SESSION_HOP_SECRET=
VAULT_SSO_PORTAL_OIDC_CLIENT_SECRET=
VAULT_PORTAL_VAULT_FERNET_KEY=
PORTAL_SECRET_ENCRYPTION_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SQLCipher file encryption key (64 hex). Generate: openssl rand -hex 32
# VAULT_PORTAL_DB_ENCRYPTION_KEY=

# Docker stack paths (inside containers)
DATABASE_URL=sqlite:////var/lib/sso-portal/portal.db
EXPORTS_DIR=/var/lib/sso-portal/exports
PORTAL_DATA_DIR=/var/lib/sso-portal
OAUTH2_PROXY_NETWORK_MODE=docker
OAUTH2_PROXY_DEFAULT_URL=http://oauth2-proxy-core:4180

# Host binds (compose)
SSO_PORTAL_DATA_DIR=./data/sso-portal
SSO_PORTAL_FILES_DATA_DIR=./data/sso-portal-files

# Optional Postgres hot store (Admin → Configuration → Stockage chaud)
# HOT_STORE_PG_USER=bastion_hot
# HOT_STORE_PG_PASSWORD=change-me
# HOT_STORE_PG_DB=bastion_hot

# Feature flags — leave false behind a public edge
RFC1918_BYPASS_ENABLED=false
SUBDOMAIN_SSO_ENABLED=false
SUBDOMAIN_AUTH_ENABLED=false
# Trusted-header SSO: use a username that looks like an e-mail as the forwarded
# e-mail when the IdP sends no email claim. Enable only when usernames are
# admin-controlled (read-only LDAP/AD) — upstream apps key accounts on it.
TRUSTED_EMAIL_FROM_USERNAME=false

# Perf — subdomain_proxy (seconds; 0 = off)
# Reuse an authenticated auth_request ALLOW in bastion-nginx (same vhost + IP +
# cookie jar). Logout / AccessGrant revocation applies within this window.
# SUBDOMAIN_AUTH_CACHE_SECONDS=10
# Idle keep-alive toward CrushFTP upstreams (keep below CrushFTP's idle timeout).
# CRUSHFTP_UPSTREAM_KEEPALIVE_SECONDS=10

# Image pins (Docker Hub défaut ; miroir GHCR = ghcr.io/vincenttisseront/…)
# Aligner sur la GitHub Release : https://github.com/vincenttisseront/bastion-app/releases
# BASTION_APP_IMAGE=vincenttisseront/bastion-pro-app:v0.11.7
# BASTION_MIGRATE_IMAGE=vincenttisseront/bastion-pro-migrate:v0.11.7
# BASTION_NGINX_IMAGE=vincenttisseront/bastion-pro-nginx:v0.11.7
# BASTION_APP_IMAGE=ghcr.io/vincenttisseront/bastion-pro-app:v0.11.7

LOG_LEVEL=INFO
LOG_FORMAT=text
