PORTAL_DOMAIN=localhost
SSO_PORTAL_DEFAULT_REALM_SLUG=ar-systems
PORTAL_ENVIRONMENT=development
VAULT_PORTAL_INTERNAL_TOKEN=dev-token-local-only
# HMAC break-glass JWT — obligatoire en production (PORTAL_ENVIRONMENT=production)
BREAKGLASS_JWT_SECRET=
# HMAC session-cookie hop — obligatoire hors PORTAL_ENVIRONMENT=test
SESSION_HOP_SECRET=
VAULT_SSO_PORTAL_OIDC_CLIENT_SECRET=
VAULT_PORTAL_VAULT_FERNET_KEY=
PORTAL_SECRET_ENCRYPTION_KEY=
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SQLCipher (chiffrement fichier portal.db) — distinct de la clé Fernet. 64 hex chars.
# Générer : openssl rand -hex 32
# Persisté sous {VAULT_KEYS_DIR}/db_encryption.key au premier boot.
# VAULT_PORTAL_DB_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./portal.db
EXPORTS_DIR=./exports
PORTAL_DATA_DIR=./data/sso-portal
# Optional Postgres hot store (docker compose service ``postgres``).
# Configured in Admin → Sécurité → Stockage chaud (not via DATABASE_URL).
# HOT_STORE_PG_PASSWORD is re-applied on every postgres start (local socket sync) —
# you do not need a prior "admin" password. Use the same value in the Admin UI.
# HOT_STORE_PG_USER=bastion_hot
# HOT_STORE_PG_PASSWORD=change-me
# HOT_STORE_PG_DB=bastion_hot
# Blobs fichiers versionnés (défaut : {PORTAL_DATA_DIR}/private/files)
# FILES_STORAGE_DIR=./data/sso-portal-files/private/files
# Phase B — store local clé Fernet (défaut : {PORTAL_DATA_DIR}/keys)
# VAULT_KEYS_DIR=./data/sso-portal/keys
# VAULT_KEY_ROTATION_DAYS=180

# Feature flags — RFC1918 bypass OFF by default (F-04): IP chain not yet proven
# end-to-end. Set true only for isolated local LAN smoke tests.
RFC1918_BYPASS_ENABLED=false
# TCP peers allowed to set X-Real-IP / XFF (nginx-bastion → FastAPI). Fail-safe
# if empty defaults: 10.5.0.0/16,172.17.0.0/16,127.0.0.0/8
# TRUSTED_PROXY_CIDRS=10.5.0.0/16,172.17.0.0/16,127.0.0.0/8
SUBDOMAIN_SSO_ENABLED=false
SUBDOMAIN_AUTH_ENABLED=false
OAUTH2_PROXY_DEFAULT_URL=http://127.0.0.1:4180

# Phase 7 Docker — docker01 derrière Traefik (vpcbr)
# DATABASE_URL=sqlite:////var/lib/sso-portal/portal.db
# EXPORTS_DIR=/var/lib/sso-portal/exports
# PORTAL_DATA_DIR=/var/lib/sso-portal
# OAUTH2_PROXY_NETWORK_MODE=docker
# Urgence IdP TLS cassé (ex. Traefik coupé) — préférer ACME sur le FQDN Keycloak
# OAUTH2_SSL_INSECURE_SKIP_VERIFY=true
# OAUTH2_PROXY_DEFAULT_URL=http://oauth2-proxy-core:4180
# SSO_PORTAL_DATA_DIR=./data/sso-portal
# RFC1918_BYPASS_ENABLED=false
# Local smoke: docker compose -f docker-compose.yml -f docker-compose.publish.yml up -d

# Logging (text = journalctl-friendly; json = structured)
LOG_LEVEL=INFO
LOG_FORMAT=text
