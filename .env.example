PORTAL_DOMAIN=localhost
SSO_PORTAL_DEFAULT_REALM_SLUG=ar-systems
VAULT_PORTAL_INTERNAL_TOKEN=dev-token-local-only
VAULT_SSO_PORTAL_OIDC_CLIENT_SECRET=
VAULT_PORTAL_VAULT_FERNET_KEY=
PORTAL_SECRET_ENCRYPTION_KEY=
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_URL=sqlite:///./portal.db
EXPORTS_DIR=./exports

# Feature flags dev
RFC1918_BYPASS_ENABLED=true
SUBDOMAIN_SSO_ENABLED=false
SUBDOMAIN_AUTH_ENABLED=false
OAUTH2_PROXY_DEFAULT_URL=http://127.0.0.1:4180

# Logging (text = journalctl-friendly; json = structured)
LOG_LEVEL=INFO
LOG_FORMAT=text
